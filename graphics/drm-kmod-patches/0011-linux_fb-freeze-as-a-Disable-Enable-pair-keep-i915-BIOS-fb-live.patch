diff --git a/drivers/gpu/drm/linux_fb.c b/drivers/gpu/drm/linux_fb.c
index 9d39066..22a5135 100644
--- a/drivers/gpu/drm/linux_fb.c
+++ b/drivers/gpu/drm/linux_fb.c
@@ -189,6 +189,16 @@ pe_prefill_fbdev(struct drm_fb_helper *fb_helper,
 	(void)fb_helper->funcs->fb_dirty(fb_helper, &clip);
 }
 
+/*
+ * NextBSD (E19): the freeze is Darwin's kPEDisableScreen. A driver that is
+ * about to disturb the framebuffer vt(4) draws on (a BAR resize, a modeset
+ * that moves or turns off the scanout) first tells the platform expert, so
+ * the boot spinner stops touching the old mapping, then vt(4) stops writing
+ * it (FB_FLAG_NOWRITE, as before). The matching kPEEnableScreen is sent by
+ * __register_framebuffer() once the console has moved to the driver's
+ * fbdev buffer, or by vt_unfreeze_main_vd() if the driver goes away first.
+ * In text mode no op is sent and the freeze is exactly as before.
+ */
 void
 vt_freeze_main_vd(struct apertures_struct *a)
 {
@@ -196,14 +206,8 @@ vt_freeze_main_vd(struct apertures_struct *a)
 	int i;
 	bool overlap = false;
 
-	if (main_vd && main_vd->vd_driver && main_vd->vd_softc &&
-	    /* For these, we know the softc (or its first field) is of type fb_info */
-	    (strcmp(main_vd->vd_driver->vd_name, "efifb") == 0
-	    || strcmp(main_vd->vd_driver->vd_name, "vbefb") == 0
-	    || strcmp(main_vd->vd_driver->vd_name, "ofwfb") == 0
-	    || strcmp(main_vd->vd_driver->vd_name, "fb") == 0
-	    || strcmp(main_vd->vd_driver->vd_name, "drmfb") == 0)) {
-		fb = main_vd->vd_softc;
+	/* For these, we know the softc (or its first field) is of type fb_info */
+	if ((fb = vt_main_vd_fb()) != NULL) {
 
 		for (i = 0; i < a->count; i++) {
 			if (fb->fb_pbase == a->ranges[i].base) {
@@ -216,11 +220,33 @@ vt_freeze_main_vd(struct apertures_struct *a)
 				break;
 			}
 		}
-		if (overlap == true)
+		if (overlap == true) {
+			if (pe_console_graphics())
+				pe_screen_disable(fb);
 			fb->fb_flags |= FB_FLAG_NOWRITE;
+		}
 	}
 }
 
+/*
+ * NextBSD (E19): i915 reusing the firmware framebuffer. True when `base' is
+ * the physical base of the framebuffer vt(4) draws on, i.e. the driver
+ * keeps scanning out the very pixels on screen at the same address (i915
+ * pins the BIOS framebuffer at its GGTT offset, PIN_OFFSET_FIXED), and the
+ * console is in graphics mode. The boot spinner can then keep drawing
+ * through the driver's init; no freeze is needed. Text mode keeps the
+ * freeze, so -v boots are unchanged.
+ */
+bool
+vt_main_vd_keeps_scanout(vm_paddr_t base)
+{
+	struct fb_info *fb;
+
+	fb = vt_main_vd_fb();
+	return (fb != NULL && fb->fb_pbase != 0 && fb->fb_pbase == base &&
+	    pe_console_graphics());
+}
+
 void
 vt_unfreeze_main_vd(void)
 {
@@ -228,6 +254,8 @@ vt_unfreeze_main_vd(void)
 
 	fb = main_vd->vd_softc;
 	fb->fb_flags &= ~FB_FLAG_NOWRITE;
+	/* Close a kPEDisableScreen the fbdev switch never closed. */
+	pe_screen_enable(NULL);
 }
 
