+++ b/drivers/gpu/drm/drm_os_freebsd.c
@@ -78,8 +78,9 @@ sysctl_pci_id(SYSCTL_HANDLER_ARGS)
 	return (sysctl_handle_string(oidp, buf, sizeof(buf), req));
 }
 
-int
-register_fictitious_range(struct drm_device *ddev, vm_paddr_t base, size_t size)
+static int
+__register_fictitious_range(struct drm_device *ddev, vm_paddr_t base,
+    size_t size, bool freeze)
 {
 	int ret;
 	struct apertures_struct *ap;
@@ -87,11 +88,13 @@ register_fictitious_range(struct drm_device *ddev, vm_paddr_t base, size_t size)
 	MPASS(base != 0);
 	MPASS(size != 0);
 
-	ap = alloc_apertures(1);
-	ap->ranges[0].base = base;
-	ap->ranges[0].size = size;
-	vt_freeze_main_vd(ap);
-	kfree(ap);
+	if (freeze) {
+		ap = alloc_apertures(1);
+		ap->ranges[0].base = base;
+		ap->ranges[0].size = size;
+		vt_freeze_main_vd(ap);
+		kfree(ap);
+	}
 
 	ret = vm_phys_fictitious_reg_range(base, base + size,
 #ifdef VM_MEMATTR_WRITE_COMBINING
@@ -107,6 +110,27 @@ register_fictitious_range(struct drm_device *ddev, vm_paddr_t base, size_t size)
 	return (ret);
 }
 
+int
+register_fictitious_range(struct drm_device *ddev, vm_paddr_t base, size_t size)
+{
+	return (__register_fictitious_range(ddev, base, size, true));
+}
+
+/*
+ * NextBSD (E19): for a driver whose fbdev buffer is the firmware framebuffer
+ * it inherited (i915 reusing the BIOS framebuffer). When that buffer is the
+ * one vt(4) is drawing on, in graphics mode, the console is left running:
+ * no freeze, so the boot spinner keeps turning through the driver's init.
+ * Otherwise this is register_fictitious_range().
+ */
+int
+register_fictitious_range_inherited(struct drm_device *ddev, vm_paddr_t base,
+    size_t size)
+{
+	return (__register_fictitious_range(ddev, base, size,
+	    !vt_main_vd_keeps_scanout(base)));
+}
+
 void
 unregister_fictitious_range(struct drm_device *ddev, vm_paddr_t base, size_t size)
 {
